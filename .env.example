# --- App ---
# Next sets NODE_ENV; do not override it for npm run dev.
NEXT_PUBLIC_BASE_URL=https://ai.hyperdrift.io

# --- PostHog (approved company project 206943, EU) ---
# Production vault supplies the public project token before the Next build.
# Browser capture runs only on ai.hyperdrift.io in production.
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_public_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Article preview and enquiries ---
# Set these only for local editorial review (npm run dev).
# Preview delivery saves the enquiry locally and sends no email; refused in production.
# ARTICLE_PREVIEW=true
# CONTACT_DELIVERY=preview
# ENQUIRY_DATA_DIR=/tmp/orchestra-preview-enquiries
# Production defaults to the existing flagship contact relay.
# CONTACT_RELAY_URL=https://hyperdrift.io/api/contact
# Production records default to ~/.local/share/hyperdrift/orchestra/enquiries.
# Override ENQUIRY_DATA_DIR with an owned persistent directory if required.
# Separate build output when checking alongside a running dev server:
# NEXT_OUTPUT_DIR=.next-check
